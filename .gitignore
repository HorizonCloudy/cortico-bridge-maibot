# cortico-bridge-maibot — 忽略规则（maibot 侧桥，纯 Python 插件）
# 依据：本仓 tests/ 用 pytest（tests/conftest.py 存在），跑一次就落 __pycache__ 与 .pytest_cache。

# ── 缓存 ──
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── 构建 / 打包产物 ──
build/
dist/

# ── 日志 ──
*.log
logs/

# ── 临时工作目录 ──
tmp/
.tmp/
*.tmp

# ── 编辑器 / OS 垃圾 ──
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# 本仓没有 package-lock.json（非 Node 包），不存在 lock 取舍。
